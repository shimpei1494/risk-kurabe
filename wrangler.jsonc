{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "risk-kurabe",
  "account_id": "53af804e239e6294ad9a766add0c6e00",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
