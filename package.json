    "data:tokyo-risk:validate": "bash scripts/data/validate-tokyo-regional-risk.sh",
    "data:tokyo-risk:verify-remote": "node scripts/data/verify-remote-tokyo-regional-risk.mjs",
    "data:upload": "bash scripts/data/upload-tokyo-regional-risk.sh",
    "deploy": "vp build && vp exec cf deploy --prebuilt",
    "dev": "vp dev",
    "doctor": "react-doctor . --verbose --yes --no-lint",
    "fallow": "vp exec fallow dead-code",
    "fix": "vp check --fix",
    "postinstall": "vp run cf-typegen",
    "preview": "vp preview",
    "test": "vp test",
    "type-check": "vp check --no-lint"
  },
