{
  "name": "risk-kurabe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "cf-typegen": "vp exec cf workers types --include-runtime=false",
    "check": "vp check",
    "data:sources:download": "bash scripts/data/download-sources.sh",
    "data:tokyo-risk:build": "bash scripts/data/transform-tokyo-regional-risk.sh",
    "data:tokyo-risk:download": "bash scripts/data/download-sources.sh TokyoRegionalRisk",
